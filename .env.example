# Copy this file to .env and fill in your own values. NEVER commit .env.
# VITE_ variables are baked into the built site at `npm run build`, so set them BEFORE building.

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic)
# reCAPTCHA Enterprise site key registered for this web app and your Hosting domain
VITE_RECAPTCHA_SITE_KEY=
# Local development only: a debug token registered under
# Firebase console > App Check > Apps > your web app > Manage debug tokens.
# Remove it (and revoke the token) for production builds.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Optional: override the cloud model id (check the Firebase AI Logic docs for supported models)
VITE_CLOUD_MODEL=
